---
import { type MarkdownHeading } from "astro";
import { toStyleVars } from "@/lib/utils";
import Link from "@/components/common/Link.astro";
import type { StyledProps } from "@/types";

interface Props extends StyledProps {
  headings: MarkdownHeading[];
}

const { class: className, style: styleAttr, headings } = Astro.props;
---

{
  headings.length > 0 && (
    <table-of-contents>
      <div
        id="toc-wrapper"
        class:list={[className, "relative"]}
        style={styleAttr}
      >
        <ul class="overflow-y-scroll text-sm">
          {headings.map((heading) => (
            <li
              class="text-foreground/50 hover:text-accent ml-[calc(var(--depth)_*_1)] not-first:mt-1"
              style={toStyleVars({ depth: heading.depth - 1 })}
            >
              <Link href={`#${heading.slug}`}>{heading.text}</Link>
            </li>
          ))}
        </ul>
        <div
          id="viewport-indicator"
          class="bg-accent/80 rounded-surface absolute left-0 z-10 w-1 -translate-x-1/2 transition-[height,top] duration-100"
        />
      </div>
    </table-of-contents>
  )
}
