---
import { getCollection } from "astro:content";

import type { IndexEnum, StyledProps } from "@/types";

import Decorator from "@/components/common/Decorator.astro";
import Link from "@/components/common/Link.astro";
import CategoryTree from "@/components/index/CategoryTree.astro";

import { createRouteUrl } from "@/lib/utils";
import { indexType } from "@/consts";
import { getCategoryTree } from "@/lib/index/category";

interface Props extends StyledProps {
  type: IndexEnum;
  title: string;
  showCount?: boolean;
  listClass?: string;
  linkClass?: string;
}

const {
  type,
  title,
  showCount = false,
  listClass = "",
  linkClass = "",
  class: className = "",
  style: styleAttr = "",
} = Astro.props;

const indexes = await getCollection(
  "postIndex",
  (index) => index.data.type === type,
);

const categoryRoot = (await getCategoryTree()).root;
// categories 타입일 경우 CategoryTree 사용
const isCategories = type === indexType.Categories;
---

<div class:list={[className, "card space-y-1 px-4 py-2"]}>
  <Decorator>
    <span>{title}</span>
  </Decorator>
  {
    isCategories ? (
      <CategoryTree category={categoryRoot} />
    ) : (
      <ul class:list={[listClass]}>
        {indexes.map((index) => (
          <li>
            <Link
              class:list={[
                "text-foreground/70 hover:text-accent transition-colors",
                linkClass,
              ]}
              href={createRouteUrl("index", index.id)}
            >
              <span class="truncate">{index.data.name}</span>
              {showCount && (
                <span class="text-foreground/50 ml-1 text-xs">
                  ({index.data.count})
                </span>
              )}
            </Link>
          </li>
        ))}
      </ul>
    )
  }
</div>
